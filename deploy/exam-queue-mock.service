[Unit]
Description=Exam Scheduler · 模拟叫号数据源（医院侧）
Documentation=https://github.com/fore-blip/exam-scheduler
After=network.target

[Service]
Type=simple
User=examsvc
Group=examsvc
WorkingDirectory=/opt/exam-scheduler
ExecStart=/usr/bin/python3 -m simulator.queue_mock --host 127.0.0.1 --port 9000
Restart=always
RestartSec=3

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
